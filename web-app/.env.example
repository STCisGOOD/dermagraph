# Dermagraph Web App Environment Variables
# Copy this file to .env.local and fill in your values

# Privy App ID (get from https://dashboard.privy.io)
VITE_PRIVY_APP_ID=your_privy_app_id_here

# Daemon URL (where dermagraphd is running)
# Use localhost:31415 for local dev, or your Pi IP for real hardware
VITE_DAEMON_URL=http://localhost:31415

# Enable real Solana transactions (set to "true" for devnet)
VITE_USE_REAL_SOLANA=false
